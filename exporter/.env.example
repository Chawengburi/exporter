# คัดลอกเป็น .env แล้วใส่ค่าจริง — .env ถูก gitignore ไว้แล้ว
# precedence: shell env  >  exporter/.env  >  ค่า default ใน src/sites/<site>/config.ts
# (ล้อรูปแบบเดียวกับ bobby-cli/src/core/config.ts)
#
# ไฟล์เดียวรวมทุก site ตามที่ตัดสินใจไว้ (ADR-0004 — เครื่องมือเดียว ไม่แยก repo ต่อเว็บ)
# แต่ละ site prefix ตัวแปรของตัวเองไว้กันชนกัน — HotelTime เดิมใช้ PMS_* เปลี่ยนเป็น HOTELTIME_*
# ตอน rename pms-export → exporter 2026-09-28 (ticket 13, .scratch/exporter-multi-site/)
# 🔴 .env เก่าที่ยังเป็น PMS_* จะไม่ถูกอ่านแล้ว (ไม่มี fallback) — แก้ด้วย sed 's/^PMS_/HOTELTIME_/'

# ══════════════════════ HotelTime (site: hoteltime) ══════════════════════

# ── credential — ต้องมี ไม่มี default ──
HOTELTIME_USERNAME=
HOTELTIME_PASSWORD=

# ── ปลายทาง ──
# th07 คือ shard ของโรงแรมเรา ถ้าย้าย shard ต้องแก้ตรงนี้
HOTELTIME_BASE_URL=https://th07.hoteltime.com
HOTELTIME_LOGIN_PATH=/pms/login/login.aspx?ReturnUrl=%2fpms%2fWelcomepage.aspx

# ── พฤติกรรมตอนรัน ──
# false = เปิดหน้าต่างเบราว์เซอร์ให้เห็น ใช้ตอนสำรวจและ debug
HOTELTIME_HEADLESS=true
# ตัวคูณ timeout ทุกที่ (ms) — รายงานใหญ่อาจต้องเพิ่ม
HOTELTIME_TIMEOUT_MS=30000
# หน่วงระหว่าง action ตอน headful เพื่อให้คนดูทัน (ms) — 0 = ไม่หน่วง
HOTELTIME_SLOW_MO=0

# ══════════════════════ FoodStory (site: foodstory) ══════════════════════
# สเปกต้นทาง: foodstory-report-export-spec.md — ควรย้ายเข้ามาไว้ใน docs/ ของ repo นี้
# แทนที่จะปล่อยไว้ที่ Downloads (ยังไม่ได้ทำ ณ 2026-09-23)

# ── credential — ต้องมี ไม่มี default ── ระบบไม่มี public API เอกสารรองรับ
# session cookie จาก login แบบ interactive เท่านั้น
FOODSTORY_EMAIL=
FOODSTORY_PASSWORD=

# ── ปลายทาง ──
# base URL หลัก — รายงานเกือบทั้งหมดอยู่ที่นี่
FOODSTORY_BASE_URL=https://owner.foodstory.co
# 🔴 "การจองโต๊ะ" (#55 /th/reservation-report) อยู่คนละ host (manage.foodstory.co) และเป็น
# คนละ UI (ไม่ใช่ DataTables) — นอกขอบเขต ticket 02 (แค่ salebysumdate) ยังไม่เพิ่มตัวแปรสำหรับ
# host นี้จนกว่าจะมีรายงานที่ต้องใช้จริง (ดูสเปก §5.4)

# สาขาที่ต้อง assert ว่า field "สาขา" ขึ้นตรงกับค่านี้ก่อนดึงทุกครั้ง (สเปก §4.1 ข้อ 5 —
# เคย pre-selected ไว้แล้วตอน manual run แต่ห้าม assume ต้อง assert เสมอ)
FOODSTORY_BRANCH_NAME="Chaweng Buri Resort"

# ── พฤติกรรมตอนรัน ──
FOODSTORY_HEADLESS=true
# เพดาน timeout ต่อ action (ms) — ตั้งสูงกว่า HotelTime ตั้งใจ เพราะสเปกวัดจริงว่าบางหน้า
# โหลดถึง 40 วิ (/th/summary) และ re-render หลังเปลี่ยนเป็น 5000 แถวกินอีก 6-10 วิ (สเปก §4.4)
FOODSTORY_TIMEOUT_MS=60000
FOODSTORY_SLOW_MO=0
# fixed viewport — สเปก §6.6 บอกว่าตำแหน่งปุ่ม toolbar เลื่อนตามขนาดจอ ต้องตั้งค่าคงที่และ
# ห้าม resize กลางการรัน
FOODSTORY_VIEWPORT_WIDTH=1512
FOODSTORY_VIEWPORT_HEIGHT=900
