# Copy to .env and fill in. .env is git-ignored (it holds secrets: never commit it or paste it in chat).
# Precedence: shell environment > exporter/.env > defaults in the code.
#
# ON UBUNTU: `bash deploy/ubuntu/install.sh` creates .env from this file and asks for the secrets below,
# so you normally edit only ONE thing by hand afterwards: HOTELTIME_ROUNDS (search for it below).
# Everything else has a working default.

# ══════════ 1. Logins (required — the installer asks for these) ══════════
HOTELTIME_USERNAME=
HOTELTIME_PASSWORD=
FOODSTORY_EMAIL=
FOODSTORY_PASSWORD=
# Branch name exactly as shown on the FoodStory site (checked before every pull)
FOODSTORY_BRANCH_NAME="Chaweng Buri Resort"

# HotelTime server (shard). Change only if the hotel is moved to another shard.
HOTELTIME_BASE_URL=https://th07.hoteltime.com

# ══════════ 2. Alerts and uploader (the installer asks for these) ══════════
# Discord webhooks: one channel for the export leg, one for the upload leg. Unset = no messages (runs are not affected).
# Secret: anyone with the URL can post to the channel.
# DISCORD_WEBHOOK_URL_EXPORT=
# DISCORD_WEBHOOK_URL_UPLOAD=

# 2captcha key: lets FoodStory log in by itself on an unattended machine (Ubuntu). Unset = a person solves the captcha (Mac).
# Secret and paid: 2captcha.com
# TWOCAPTCHA_API_KEY=

# Uploader account for `exporter upload` (all three required; there are no defaults on purpose)
UPLOADER_URL=
UPLOADER_EMAIL=
UPLOADER_PASSWORD=

# First day of data to collect (YYYY-MM-DD). The installer sets it to the install date. Missing days after it are back-filled automatically.
# Unset = only yesterday is pulled, nothing is back-filled.
# EXPORTER_GO_LIVE=2026-10-20

# ══════════ 3. HotelTime rounds (edit by hand during the rollout) ══════════
# Which extraction rounds are switched on. Rounds run at 04, 08, 12, 16, 20 and 23 (Thai time).
#   unset or empty -> 08,12,16,20,23
#   HOTELTIME_ROUNDS=off          -> no rounds; Windmill keeps the OLD schedule (noon, 15:00, 18:00)
#   HOTELTIME_ROUNDS=08,12,16,20,23   -> rounds on; the old schedule is switched off
# A round that is not listed exits at once without logging in. A typo is an error.
# After changing it on Ubuntu, run: node windmill/setup.mjs   (see docs/UBUNTU-UPDATE-2026-11-18.md)
# HOTELTIME_ROUNDS=off

# ══════════ 4. Optional tuning (defaults are fine) ══════════
# HOTELTIME_LOGIN_PATH=/pms/login/login.aspx?ReturnUrl=%2fpms%2fWelcomepage.aspx
# HOTELTIME_HEADLESS=true          # false = show the browser window (debugging)
# HOTELTIME_TIMEOUT_MS=30000       # per-action timeout; raise it for big reports
# HOTELTIME_SLOW_MO=0              # delay between actions (ms), for watching a headful run
# FOODSTORY_BASE_URL=https://owner.foodstory.co
# FOODSTORY_HEADLESS=true
# FOODSTORY_TIMEOUT_MS=60000
# FOODSTORY_SLOW_MO=0
# FOODSTORY_VIEWPORT_WIDTH=1512    # fixed on purpose: toolbar buttons move with the window size
# FOODSTORY_VIEWPORT_HEIGHT=900
# UPLOADER_SEND_EMPTY=true         # keep off until the uploader confirms its "empty report" endpoint is deployed

# ══════════ 5. Old regime (only while HOTELTIME_ROUNDS=off) ══════════
# Extra HotelTime snapshot rounds at 06:00 and/or 23:00. Ignored once rounds are on; it never turns a round on.
# HOTELTIME_SNAPSHOT_SLOTS=06,23
# HOTELTIME_SNAPSHOT_SLOT_REPORTS=in-house-guests,rooms-status-overview,arrivals,departures
