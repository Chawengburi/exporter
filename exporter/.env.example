# ── HotelTime ──
HOTELTIME_USERNAME=
HOTELTIME_PASSWORD=
HOTELTIME_BASE_URL=https://th07.hoteltime.com
HOTELTIME_LOGIN_PATH=/pms/login/login.aspx?ReturnUrl=%2fpms%2fWelcomepage.aspx

# ── FoodStory ──
FOODSTORY_EMAIL=
FOODSTORY_PASSWORD=
FOODSTORY_BRANCH_NAME="Chaweng Buri Resort"
FOODSTORY_BASE_URL=https://owner.foodstory.co
# Solves the FoodStory login captcha by itself. Empty = a person solves it.
TWOCAPTCHA_API_KEY=

# ── Schedule ──
# First day to collect. Missing days after it are back-filled.
EXPORTER_GO_LIVE=2026-10-20
# HotelTime rounds that are on: off, or hours from 04,08,12,16,20,23. Empty = 08,12,16,20,23.
# After changing it on Ubuntu run: node windmill/setup.mjs
HOTELTIME_ROUNDS=off
# Look-ahead arrival report (arrival-ahead, ADR-0015): how many days ahead of today to read, 1-60 (e.g. 14). Empty = off.
# Keep it EMPTY until the one-time manual check is done (docs/SCRIPTS-USAGE.md, "Look-ahead arrival report")
HOTELTIME_LOOKAHEAD_DAYS=

# ── Discord alerts (empty = off) ──
DISCORD_WEBHOOK_URL_EXPORT=
DISCORD_WEBHOOK_URL_UPLOAD=

# ── Uploader ──
UPLOADER_URL=
UPLOADER_EMAIL=
UPLOADER_PASSWORD=
# true only after the uploader's "empty report" endpoint is live
UPLOADER_SEND_EMPTY=

# ── Browser (defaults) ──
HOTELTIME_HEADLESS=true
HOTELTIME_TIMEOUT_MS=30000
HOTELTIME_SLOW_MO=0
FOODSTORY_HEADLESS=true
FOODSTORY_TIMEOUT_MS=60000
FOODSTORY_SLOW_MO=0
FOODSTORY_VIEWPORT_WIDTH=1512
FOODSTORY_VIEWPORT_HEIGHT=900

# ── Old schedule only (used while HOTELTIME_ROUNDS=off) ──
HOTELTIME_SNAPSHOT_SLOTS=
HOTELTIME_SNAPSHOT_SLOT_REPORTS=
