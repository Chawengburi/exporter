# POSTGRES_PASSWORD ต้องตรงกับรหัสที่ฝังอยู่ใน DATABASE_URL ด้านล่าง (docker-compose .env ไม่รองรับ
# การอ้างตัวแปรซ้อนกันเอง) — เปลี่ยนต้องแก้สองที่นี้ให้ตรงกัน แต่จุดที่แก้แล้วคือ.env ที่ไม่ commit
# เข้า git ไม่ใช่ docker-compose.yml ที่ commit เหมือนเดิมอีกต่อไป
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgres://postgres:changeme@db/windmill?sslmode=disable

# Community Edition — ปักหมุดเวอร์ชันไว้ (ไม่ใช้ :main) เพื่อให้ setup ทำซ้ำได้แน่นอน
# ดูเวอร์ชันล่าสุดที่ https://github.com/windmill-labs/windmill/releases
WM_IMAGE=ghcr.io/windmill-labs/windmill:1.815.0

# ต้องมี default ใน docker-compose.yml (LOG_MAX_SIZE/LOG_MAX_FILE) ไม่ต้องตั้งที่นี่ก็รันได้
